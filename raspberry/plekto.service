[Unit]
Description=Plekto - pagina web (progetto retainer) e collegamento con la macchina
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
WorkingDirectory=/opt/plekto/raspberry/plekto
Environment=PLEKTO_DATI=/var/lib/plekto
Environment=PLEKTO_PORTA=/dev/ttyUSB0
Environment=PYTHONPATH=/opt/plekto-lib
ExecStart=/usr/bin/python3 -m uvicorn server:app --host 0.0.0.0 --port 80
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
