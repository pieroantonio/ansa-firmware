[Unit]
Description=Ansa - pagina web (progetto retainer) e collegamento con la macchina
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
WorkingDirectory=/opt/ansa/raspberry/ansa
Environment=ANSA_DATI=/var/lib/ansa
Environment=ANSA_PORTA=/dev/ttyUSB0
ExecStart=/opt/ansa-venv/bin/uvicorn server:app --host 0.0.0.0 --port 80
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
